# Required by the deployment environment. The current FastAPI contract does
# not enforce API_KEY yet; keep it set for the authentication layer that fronts
# the service in production.
API_KEY=replace-with-a-long-random-value

# API URL used by the local Streamlit process. docker-compose overrides this
# inside the UI container with http://api:8000.
NONPURSUIT_API_URL=http://127.0.0.1:8000

# Recon resilience settings.
RECON_RATE_LIMIT_RPS=2
RECON_SENSITIVE_HOSTS=
RECON_PROXIES=
RECON_MAX_RETRIES=2
RECON_BACKOFF_BASE_SECONDS=0.5

# Streamlit runtime settings.
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLECORS=false
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
