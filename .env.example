# Required by the deployment environment. The current FastAPI contract does
# not enforce API_KEY yet; keep it set for the authentication layer that fronts
# the service in production.
API_KEY=replace-with-a-long-random-value

# API URL used by the local Streamlit process. docker-compose overrides this
# inside the UI container with http://api:8000.
NONPURSUIT_API_URL=http://127.0.0.1:8000

# Recon resilience settings.
RECON_RATE_LIMIT_RPS=2
RECON_SENSITIVE_HOSTS=
RECON_PROXIES=
RECON_MAX_RETRIES=2
RECON_BACKOFF_BASE_SECONDS=0.5

# Streamlit runtime settings.
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLECORS=false
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Owner console (pages/11_Admin.py). Unset by default and that is the
# intended state for any install that is not yours: with no key set the
# console is not reachable and its sidebar link is not drawn. Set it and
# the page appears behind a prompt that compares against this value.
#
# It gates a view of every record in the database, so make it long and
# random -- it is not a memorable password, it is a capability. Leave the
# line commented out rather than setting it blank.
# NON_PURSUIT_ADMIN_KEY=replace-with-a-long-random-value
