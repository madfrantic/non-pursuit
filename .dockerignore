# Keep the image lean and, more importantly, keep local user data out of it.
# data/tracker.db and logs/ hold real personal information; an image is a
# distributable artifact and must never carry them.
.git
.gitignore
.env
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
tests/
logs/

data/*.db
data/*.db-wal
data/*.db-shm

# Raw upstream site lists. Only the merged registry (data/sites-unified.json)
# is read at runtime, and site_registry.ensure_registry re-fetches these three
# on an explicit refresh -- so shipping them would just make the image bigger.
# sites-unified.json itself IS shipped: without it every container start
# rebuilds the registry over the network, and an offline start leaves
# /api/scan returning 503.
data/wmn-data.json
data/sherlock-data.json
data/maigret-data.json

# One-off export artifact from scripts/extract_platform_data.py; no runtime
# code reads it.
data/sites.json
