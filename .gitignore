venv/
__pycache__/
*.pyc
.pytest_cache/
# Encryption key -- NEVER commit this, even if empty.
# The comment lives on its own line on purpose: .gitignore has no
# inline-comment syntax, so `.env  # ...` is read as a literal
# filename and silently matches nothing. That typo is how the key
# reached a public repo.
.env

# Local user data -- broker requests, notes, and now self-search exposure
# answers. Real personal data belongs on the user's machine only, never in
# git history.
data/tracker.db

# Feature-usage counters. Not secret -- the schema is event names and
# integers, and utils/usage_metrics.py rejects anything else -- but it is
# per-deployment runtime state. Committing it would ship whatever numbers
# happened to be on the developer's machine as though they were real usage.
data/usage_metrics.db

# Outstanding human-review tasks (utils/review_queue.py). Its `reason` column
# is a closed vocabulary, but `note` is free text and a user will paste a name
# into one eventually, so this is ignored on the same grounds as tracker.db.
data/review_queue.db

# WhatsMyName site list, downloaded on first scan and cached locally. Not
# committed: it's CC BY-SA 4.0 (c) Micah Hoffman, so keeping it out of git
# avoids redistributing ShareAlike'd content, and the list churns upstream
# often enough that a pinned copy would rot while still looking current.
data/wmn-data.json

# Diagnostic log -- can end up holding identifying details caught in an
# exception message, same reasoning as data/tracker.db above.
logs/

# Raw multi-megabyte logo source sheets (four crops each, checkerboard
# preview background baked in) -- kept locally for re-processing, but the
# app only ever reads the small derived asset in assets/.
/LOGOBRAND.png
/LOGOBRAND_2.png
*.png
!assets/*.png
!assets/**/*.png

# Unified site registry, merged at runtime from WhatsMyName (CC BY-SA 4.0),
# Sherlock (MIT) and Maigret (MIT). Not committed: the WMN half is ShareAlike,
# and the merged artefact would carry that obligation into this repo the same
# way data/wmn-data.json would. Rebuild it with site_registry.ensure_registry().
data/sites-unified.json
data/sherlock-data.json
data/maigret-data.json

# Evidence screenshots — broker pages rendered with the user's PII on them.
data/evidence/

# Master-password vault material (per-install salt + password verifier).
data/vault.salt
data/vault.verifier
data/*.bak.*
