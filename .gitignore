venv/
__pycache__/
*.pyc
.pytest_cache/

# Local user data -- broker requests, notes, and now self-search exposure
# answers. Real personal data belongs on the user's machine only, never in
# git history.
data/tracker.db

# WhatsMyName site list, downloaded on first scan and cached locally. Not
# committed: it's CC BY-SA 4.0 (c) Micah Hoffman, so keeping it out of git
# avoids redistributing ShareAlike'd content, and the list churns upstream
# often enough that a pinned copy would rot while still looking current.
data/wmn-data.json

# Diagnostic log -- can end up holding identifying details caught in an
# exception message, same reasoning as data/tracker.db above.
logs/

# Raw multi-megabyte logo source sheets (four crops each, checkerboard
# preview background baked in) -- kept locally for re-processing, but the
# app only ever reads the small derived asset in assets/.
/LOGOBRAND.png
/LOGOBRAND_2.png
